# WhatsApp Cloud API (Meta) credentials
# Copy this file to .env and replace the placeholder values.

# Access token from Meta for Developers > WhatsApp > API Setup.
# Use a permanent System User token for production; temporary tokens expire.
WHATSAPP_ACCESS_TOKEN=

# Phone number ID from Meta for Developers > WhatsApp > API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# Graph API version shown in your Meta app (e.g. v23.0).
WHATSAPP_API_VERSION=v23.0

# Message recipients in international format, digits only.
WHATSAPP_RECIPIENT_1=255774634254
WHATSAPP_RECIPIENT_2=255719160587
